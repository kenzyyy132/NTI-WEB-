const fs = require("fs");

function readGrades() {

    const data = fs.readFileSync(
        "./data/grades.json",
        "utf-8"
    );

    const grades = JSON.parse(data);

    console.log("Student Grades:");

    grades.forEach(item => {
        console.log(
            `${item.id} - ${item.student} - ${item.subject} : ${item.grade}`
        );
    });

}

module.exports = readGrades;



