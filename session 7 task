const fs = require("fs");
const saveGrades = require("./save.grades");

function deleteGrade(value) {

    const data = fs.readFileSync(
        "./data/grades.json",
        "utf-8"
    );

    let grades = JSON.parse(data);


    grades = grades.filter(item =>
        item.id !== value &&
        item.student !== value
    );


    saveGrades(grades);

    console.log("Grade deleted successfully");

}

module.exports = deleteGrade;



========================
modules/update.grade.js
========================

const fs = require("fs");
const saveGrades = require("./save.grades");


function updateGrade(id, newGrade) {

    const data = fs.readFileSync(
        "./data/grades.json",
        "utf-8"
    );


    const grades = JSON.parse(data);


    const student = grades.find(
        item => item.id === id
    );


    if (student) {

        student.grade = newGrade;

        saveGrades(grades);

        console.log("Grade updated successfully");

    } else {

        console.log("Student not found");

    }

}


module.exports = updateGrade;



